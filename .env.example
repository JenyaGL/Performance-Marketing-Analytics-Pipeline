# Copy to .env and fill in. Never commit .env.
GCP_PROJECT=your-gcp-project-id
BQ_LOCATION=US
# Absolute path on your Mac to the service-account JSON key (mounted read-only into the container)
GCP_KEYFILE_HOST_PATH=/absolute/path/to/service-account.json

# Alert emails (Gmail SMTP). SMTP_PASSWORD is a Gmail *app password* (needs 2-Step Verification):
# https://myaccount.google.com/apppasswords
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
ALERT_EMAIL_TO=you@gmail.com
